{
  "name": "kemer/bulk-sms-backoffice",
  "type": "project",
  "description": "Multi-tenant SIM-based SMS gateway management",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {"App\\": "app/"}
  },
  "scripts": {
    "post-autoload-dump": ["@php artisan package:discover --ansi"]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
